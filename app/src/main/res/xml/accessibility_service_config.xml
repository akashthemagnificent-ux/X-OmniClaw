<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility service configuration.
    Defines how the automation tools interact with Android's accessibility
    framework to read the full View Tree and perform actions.

    accessibilityEventTypes: event types to listen for; typeAllMask covers all
    accessibilityFeedbackType: feedback type; feedbackGeneric is the generic kind
    notificationTimeout: event notification timeout in milliseconds
    canRequestTouchExplorationMode: whether touch exploration may be requested
    canPerformGestures: whether gesture dispatch is allowed
    canRetrieveWindowContent: whether window content can be read — required for the View Tree
    canRequestEnhancedWebAccessibility: whether enhanced web accessibility may be requested
    canRequestFilterKeyEvents: whether key events may be filtered
    accessibilityFlags: behaviour flags
        - flagRetrieveInteractiveWindows: include interactive window content
        - flagIncludeNotImportantViews: include unimportant views (unused)
        - flagRequestEnhancedWebAccessibility: request enhanced web accessibility
        - flagReportViewIds: report view IDs
        - flagRequestFilterKeyEvents: request key event filtering
    settingsActivity: the settings Activity class name
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRequestTouchExplorationMode="true"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canRequestEnhancedWebAccessibility="true"
    android:canRequestFilterKeyEvents="true"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagRequestEnhancedWebAccessibility|flagReportViewIds|flagRequestFilterKeyEvents"
    android:settingsActivity="com.example.accessibilitytool.SettingsActivity" />